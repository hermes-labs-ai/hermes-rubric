url: "https://hermes-labs.ai"
keywords:
  - "large language models"
  - "LLM evaluation"
  - "LLM-as-judge"
  - "rubric scoring"
  - "AI audit"
  - "evidence-cited scoring"
  - "ai-act"
  - "agent evaluation"
  - "fluency bias"
  - "structured evaluation"
